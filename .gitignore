# --- Secrets & local config ---
.env
.env.*
!.env.example
.claude/settings.local.json

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- Build output (installers, the frozen sidecar and their work dirs) ---
shell/dist/
release/
/dist-app*/
/dist-sidecar/
/build-sidecar/
# generated from app-meta.json at build time
packaging/win-version.txt

# --- The library itself (user content — NEVER committed) ---
# On-disk media (covers, pages) and the rebuildable SQLite index live outside VCS.
# ANCHORED to the repo root on purpose: an unanchored `library/` also swallowed
# backend/app/library/ — the vault + index source module.
/vault/
/library/
*.db
*.db-wal
*.db-shm

# --- Design working files (mockup PNGs stay untracked; the HTML is tracked) ---
design/*.png

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
